# LAN IP of the docker host. Lucy's DNS must send euiot.trifo.com, eudispatch.trifo.com and
# pt/lt/push/live.lightfieldcamera.com.cn here. Also set server.ip in config.yaml to this.
SERVER_IP=192.168.1.10
# Host port for the web UI / REST API (also served on :80)
UI_PORT=8110
# Time zone for schedules
TZ=America/Denver
